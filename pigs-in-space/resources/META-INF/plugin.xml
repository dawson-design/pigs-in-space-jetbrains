<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>pigs-in-space</id>
    <version>1.0.0</version>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Pigs in Space</name>
    <category>UI</category>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>Alastair Dawson</vendor>

    <idea-version since-build="242"/>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    Primordial Prometheus theme engineers have fused the aesthetic DNA of Solarized and Twilight, creating Pigs in Space—a theme purpose-built for epic coding expeditions.
    Darker than Event Horizon yet brighter than The Fifth Element, it offers visual harmony, balanced contrast, and interstellar readability, ensuring comfort as you journey
    through even the most mysterious corners of your codebase. With Pigs in Space, no one will hear you scream—because a thoughtfully designed palette and exceptional clarity
    transform your IDE into the ultimate deep-flow coding environment.
  ]]></description>
    <icon path="/META-INF/pluginIcon.svg"/>

    <!-- Short summary of new features and bugfixes in the latest plugin version.
         Displayed on the Plugin Page and IDE Plugin Manager. Simple HTML elements can be included between <![CDATA[  ]]> tags. -->
    <change-notes><![CDATA[
    Initial release of the theme.
  ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="pigs-in-space" path="/theme/pigsinspace.theme.json"/>
    </extensions>
</idea-plugin>